ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

DEFAULT_REGION=Shanghai
DEFAULT_THRESHOLDS=1,5,10
DEFAULT_LEAD_TIMES=0,1,2

# 2025-04-11 CREF NetCDF case; used by both Phase 4 and Phase 5.
# external/ is gitignored and never committed.
FENGLEI_CASE_DIR=external/20250411风雷预测资料
RADAR_OBS_DIR=external/20250411观测资料

# 2026-04-07 Phase 5 case: forecast filenames use BJT; CREF .bin clocks use UTC.
FENGLEI_DAILY_DIR=external/20260407风雷预测资料
RADAR_DAILY_DIR=external/20260407观测资料
