RADAR_OBS_DIR=external/smoke_data/radar

# Phase 5 full-day Beijing-time case. Point each variable at the directory
# containing the 7200 REFMOSAIC .bz2 files and 249 CREF .bin deliveries.
FENGLEI_DAILY_DIR=external/储海后给的资料/20260407
RADAR_DAILY_DIR=external/20260407雷达观测资料
