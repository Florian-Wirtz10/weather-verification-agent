DEEPSEEK_API_KEY=

# Canonical private-data root. Relative paths are resolved from the project root.
# external/ is gitignored and never committed.
WEATHER_DATA_ROOT=external/datasets

# Optional per-product overrides. Uncomment only when a product is stored
# outside WEATHER_DATA_ROOT.
# FENGLEI_CASE_DIR=/srv/weather-agent/data/cases/2025-04-11/forecasts/fenglei
# RADAR_OBS_DIR=/srv/weather-agent/data/cases/2025-04-11/observations/cref
# FENGLEI_20260408_DIR=/srv/weather-agent/data/cases/2026-04-08/forecasts/fenglei
# RADAR_20260408_DIR=/srv/weather-agent/data/cases/2026-04-08/observations/cref
# UPSTREAM_MODEL_DIRS=/srv/weather-agent/data/models/stormdit
# BENCHMARK_PACKAGE_DIR=/srv/weather-agent/data/benchmarks/2025-04-11/wuhan-zero-shot

# Generated task artifacts. Old completed jobs are removed automatically.
WEB_JOB_OUTPUT_DIR=outputs/web_jobs
WEB_JOB_RETENTION_DAYS=7
WEB_JOB_MAX_STORAGE_GB=20
WEB_JOB_CLEANUP_INTERVAL_MINUTES=60
