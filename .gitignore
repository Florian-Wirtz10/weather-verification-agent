# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ruff_cache/
.mypy_cache/

# Node (only present if Claude Code or tooling writes local caches here)
node_modules/

# Environment
.env

# Claude Code project state — local to this machine/session, must never
# be shared or committed (permission grants, session-local settings).
# .claude/settings.json (if ever added for team-shared config) stays tracked.
.claude/settings.local.json
.claude/ide/
.claude/worktrees/

# Outputs
outputs/*
!outputs/figures/
!outputs/tables/
!outputs/reports/
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep
!outputs/reports/.gitkeep

# Data
data/
*.nc
*.h5
*.hdf
*.grib
*.grb
*.npy
*.npz

# Private reference material (project requirement docs, real case sample
# data from upstream 风雷/雷达 sources) — not ours to redistribute, never
# committed. data_io real-data readers must not hardcode paths into this.
external/

# macOS
.DS_Store

# VS Code
.vscode/

# pytest
.pytest_cache/
.coverage
htmlcov/
