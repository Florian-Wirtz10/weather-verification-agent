{
  "name": "weather-verification-agent",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Node.js and the non-root OS user come from maintained, versioned
  // devcontainer Features instead of a hand-rolled "curl | bash" installer
  // in the Dockerfile — reproducible across machines and easy to bump.
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "dev",
      "uid": "1000",
      "gid": "1000",
      "upgradePackages": false,
      "installZsh": false
    }
  },

  "workspaceFolder": "/workspace",

  // The ONLY thing mounted from the host is this project folder. No SSH
  // agent forwarding, no docker.sock, no host credential/config directories
  // — the container cannot see or touch anything on the Mac outside of
  // this repo.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "runArgs": ["--init"],

  // Persist Claude Code's session state (~/.claude — holds chat history
  // under projects/) and Codex's login/config (~/.codex) across container
  // rebuilds. Both are Docker NAMED VOLUMES, not host paths: they expose no
  // file on the Mac, so the isolation guarantee above still holds — they
  // only survive rebuilds so conversations and logins aren't lost every
  // time the container is rebuilt.
  "mounts": [
    "source=${localWorkspaceFolderBasename}-claude-home,target=/home/dev/.claude,type=volume",
    "source=${localWorkspaceFolderBasename}-codex-home,target=/home/dev/.codex,type=volume"
  ],

  // Run as an unprivileged, host-UID-matched user rather than root, so
  // files created in the container keep sane ownership on the host and a
  // compromised process/dependency can't act with root inside the
  // container either.
  "remoteUser": "dev",
  "updateRemoteUserUID": true,

  // postCreateCommand runs after the Node/user features are applied, so
  // both npm and the project's own package are set up here in one place —
  // versions are pinned so every clone of this repo ends up identical.
  // The chown/mkdir hand the freshly-created .claude/.codex volumes
  // (mounted root-owned) to the dev user. Claude Code's account login
  // token actually lives in ~/.claude.json, OUTSIDE the mounted ~/.claude
  // directory, so on a fresh container it's a plain file that vanishes on
  // rebuild; the mv+symlink step relocates it into the persisted volume
  // once so future rebuilds resume an already-logged-in session instead of
  // prompting a re-login.
  "postCreateCommand": "sudo mkdir -p /home/dev/.codex && sudo chown -R dev:dev /home/dev/.claude /home/dev/.codex && if [ -f /home/dev/.claude.json ] && [ ! -L /home/dev/.claude.json ]; then mv /home/dev/.claude.json /home/dev/.claude/.claude.json; fi && ln -sfn /home/dev/.claude/.claude.json /home/dev/.claude.json && npm install -g @anthropic-ai/claude-code@2.1.201 @openai/codex@0.144.1 && pip install --user -e \".[dev]\"",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.typeCheckingMode": "basic",
        "editor.formatOnSave": true
      }
    }
  },

  "forwardPorts": [8501]
}
