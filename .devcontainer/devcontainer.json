{
  "name": "weather-verification-agent",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Node.js (required by Codex CLI) and the non-root OS user come from
  // maintained, versioned Dev Container Features.
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "dev",
      "uid": "1000",
      "gid": "1000",
      "upgradePackages": false,
      "installZsh": false
    }
  },

  "workspaceFolder": "/workspace",

  // The ONLY thing mounted from the host is this project folder. No SSH
  // agent forwarding, no docker.sock, no host credential/config directories
  // — the container cannot see or touch anything on the Mac outside of
  // this repo.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "runArgs": ["--init"],

  // Keep personal Codex authentication, configuration, and saved sessions
  // across container rebuilds in a Docker named volume outside the repo.
  "mounts": [
    "source=${localWorkspaceFolderBasename}-codex-home,target=/home/dev/.codex,type=volume"
  ],

  // Run as an unprivileged, host-UID-matched user rather than root, so
  // files created in the container keep sane ownership on the host and a
  // compromised process/dependency can't act with root inside the
  // container either.
  "remoteUser": "dev",
  "updateRemoteUserUID": true,

  // Install Codex for this development environment and the project's Python
  // dependencies. No other AI command-line tools are installed.
  "postCreateCommand": "sudo mkdir -p /home/dev/.codex && sudo chown -R dev:dev /home/dev/.codex && npm install -g @openai/codex@0.144.1 && pip install --user -e \".[dev]\"",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.typeCheckingMode": "basic",
        "editor.formatOnSave": true
      }
    }
  },

  "forwardPorts": [8501]
}
