{
  "name": "PROJECT_NAME_HERE",

  "build": {
    "dockerfile": "Dockerfile"
  },

  // Node.js and the non-root OS user come from maintained, versioned
  // devcontainer Features instead of a hand-rolled "curl | bash" installer
  // in the Dockerfile — reproducible across machines and easy to bump.
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "dev",
      "uid": "1000",
      "gid": "1000",
      "upgradePackages": false,
      "installZsh": false
    }
  },

  "workspaceFolder": "/workspace",

  // The ONLY thing mounted from the host is this project folder. No SSH
  // agent forwarding, no docker.sock, no host credential/config directories
  // — the container cannot see or touch anything on the host outside of
  // this repo. Do not add extra "mounts" entries unless you deliberately
  // want to widen that.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "runArgs": ["--init"],

  // Run as an unprivileged, host-UID-matched user rather than root, so
  // files created in the container keep sane ownership on the host and a
  // compromised process/dependency can't act with root inside the
  // container either.
  "remoteUser": "dev",
  "updateRemoteUserUID": true,

  // Versions pinned so every clone/copy of this project ends up with an
  // identical environment. Bump the Claude Code version deliberately by
  // checking: npm view @anthropic-ai/claude-code version
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code@2.1.201 && pip install --user -e \".[dev]\"",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.typeCheckingMode": "basic",
        "editor.formatOnSave": true
      }
    }
  },

  // Add ports your app actually serves on (e.g. 8501 for Streamlit).
  // An empty list is the safe default — don't forward ports "just in case".
  "forwardPorts": []
}
